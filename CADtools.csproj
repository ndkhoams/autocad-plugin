<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>CADtools</AssemblyName>
		<RootNamespace>CADtools</RootNamespace>
		<CadYear Condition="'$(CadYear)' == ''">2023</CadYear>
		<CadApiGroup Condition="'$(CadApiGroup)' == '' and ('$(CadYear)' == '2019' or '$(CadYear)' == '2020')">R23</CadApiGroup>
		<CadApiGroup Condition="'$(CadApiGroup)' == '' and ('$(CadYear)' == '2021' or '$(CadYear)' == '2022' or '$(CadYear)' == '2023' or '$(CadYear)' == '2024')">R24</CadApiGroup>
		<CadApiGroup Condition="'$(CadApiGroup)' == '' and ('$(CadYear)' == '2025' or '$(CadYear)' == '2026' or '$(CadYear)' == '2027')">R25</CadApiGroup>
		<TargetFramework Condition="'$(CadApiGroup)' == 'R25'">net8.0-windows</TargetFramework>
		<TargetFramework Condition="'$(CadApiGroup)' != 'R25'">net48</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
		<OutputPath Condition="'$(OutputPath)' == ''">bin\$(CadApiGroup)\$(Configuration)\</OutputPath>
		<AcadRoot Condition="'$(AcadRoot)' == ''">C:\Program Files\Autodesk\AutoCAD $(CadYear)\</AcadRoot>
		<SheetSetTlb Condition="'$(SheetSetTlb)' == '' and '$(CadApiGroup)' == 'R23'">C:\Program Files\Common Files\Autodesk Shared\AcSmComponents23.tlb</SheetSetTlb>
		<SheetSetTlb Condition="'$(SheetSetTlb)' == '' and '$(CadApiGroup)' == 'R24'">C:\Program Files\Common Files\Autodesk Shared\AcSmComponents24.tlb</SheetSetTlb>
		<SheetSetTlb Condition="'$(SheetSetTlb)' == '' and '$(CadApiGroup)' == 'R25'">C:\Program Files\Common Files\Autodesk Shared\AcSmComponents25.tlb</SheetSetTlb>
		<AcadComVersion Condition="'$(AcadComVersion)' == '' and '$(CadApiGroup)' == 'R23'">23</AcadComVersion>
		<AcadComVersion Condition="'$(AcadComVersion)' == '' and '$(CadApiGroup)' == 'R24'">24</AcadComVersion>
		<AcadComVersion Condition="'$(AcadComVersion)' == '' and '$(CadApiGroup)' == 'R25'">25</AcadComVersion>
		<DefineConstants Condition="'$(CadApiGroup)' == 'R23'">$(DefineConstants);CAD_ACSM_R23</DefineConstants>
		<DefineConstants Condition="'$(CadApiGroup)' == 'R25'">$(DefineConstants);CAD_ACSM_R25</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="acmgd">
			<HintPath>$(AcadRoot)acmgd.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="acdbmgd">
			<HintPath>$(AcadRoot)acdbmgd.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="accoremgd">
			<HintPath>$(AcadRoot)accoremgd.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<!-- Ribbon UI: RibbonControl/RibbonTab/RibbonButton/ComponentManager nam trong AdWindows.dll -->
		<Reference Include="AdWindows">
			<HintPath>$(AcadRoot)AdWindows.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<COMFileReference Include="$(SheetSetTlb)">
			<EmbedInteropTypes>false</EmbedInteropTypes>
		</COMFileReference>
		<COMFileReference Include="C:\Program Files\Common Files\Autodesk Shared\acax$(AcadComVersion)enu.tlb">
			<EmbedInteropTypes>false</EmbedInteropTypes>
		</COMFileReference>
		<COMFileReference Include="C:\Program Files\Common Files\Autodesk Shared\axdb$(AcadComVersion)enu.tlb">
			<EmbedInteropTypes>false</EmbedInteropTypes>
		</COMFileReference>
	</ItemGroup>
</Project>